<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cursos</title>
</head>
<body>
    <h1>Alunos cadasrados</h1>
     <% alunosArray.forEach(aluno => { %>
        <div>
            <h2>
                Matrícula: <%= aluno.matricula %>
                Nome: <%= aluno.nome %>
                Curso: <%= aluno.curso %>
            </h2>
        </div>
    <% }) %>
</body>
</html>